# ==============================================================================
# TIBATIBACYC ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================

# URL Website Publik
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. KEAMANAN & ADMIN DASHBOARD
# ------------------------------------------------------------------------------
# PIN untuk login admin (Wajib diisi di production)
ADMIN_PIN=tibatiba2026

# Secret key untuk menandatangani session token cookie HMAC-SHA256 (Wajib di production)
ADMIN_SESSION_SECRET=ganti_dengan_random_secret_string_yang_panjang_dan_kuat

# ------------------------------------------------------------------------------
# 2. GOOGLE DRIVE OAUTH 2.0 (TOOLS UPLOAD MEDIA DOKUMENTASI)
# ------------------------------------------------------------------------------
# Buat OAuth 2.0 Client di Google Cloud Console (Tipe: Web Application)
# Redirect URI: https://<domain-anda>/api/admin/drive/oauth/callback (dan http://localhost:3000/api/admin/drive/oauth/callback untuk lokal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Refresh token diperoleh satu kali dengan menekan "Hubungkan Google Drive" di dashboard admin
GOOGLE_REFRESH_TOKEN=

# (Opsional) ID folder induk 'Kegiatan' di Google Drive.
# Jika dikosongkan, sistem akan otomatis membuat/mencari folder "Kegiatan TibatibaCYC" di root Drive.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# (Opsional) Batas maksimal ukuran foto sebelum upload/konversi dalam MB (Default: 50)
MAX_PHOTO_SIZE_MB=50

# ------------------------------------------------------------------------------
# 3. CLOUDINARY (GALERI WEBSITE & POSTER INSTASTORY)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ------------------------------------------------------------------------------
# 4. FIREBASE FIRESTORE & ANALYTICS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 5. TELEGRAM BOT (NOTIFIKASI PENGUNJUNG & JOIN WHATSAPP)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

